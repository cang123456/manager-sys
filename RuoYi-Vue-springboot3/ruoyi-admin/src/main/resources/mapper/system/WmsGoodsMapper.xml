<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.WmsGoodsMapper">
    
    <resultMap type="WmsGoods" id="WmsGoodsResult">
        <result property="goodsId"    column="goods_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="goodsNo"    column="goods_no"    />
        <result property="categoryId"    column="category_id"    />
        <result property="spec"    column="spec"    />
        <result property="unit"    column="unit"    />
        <result property="stockNum"    column="stock_num"    />
        <result property="warnStock"    column="warn_stock"    />
        <result property="purchasePrice"    column="purchase_price"    />
        <result property="salePrice"    column="sale_price"    />
        <result property="thumbUrl"    column="thumb_url"    />
        <result property="originUrl"    column="origin_url"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectWmsGoodsVo">
        select goods_id, goods_name, goods_no, category_id, spec, unit, stock_num, warn_stock, purchase_price, sale_price, thumb_url, origin_url, remark, status, create_by, create_time, update_by, update_time, del_flag from wms_goods
    </sql>

    <select id="selectWmsGoodsList" parameterType="WmsGoods" resultMap="WmsGoodsResult">
        <include refid="selectWmsGoodsVo"/>
        <where>  
            <if test="goodsName != null  and goodsName != ''"> and goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="goodsNo != null  and goodsNo != ''"> and goods_no = #{goodsNo}</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="spec != null  and spec != ''"> and spec = #{spec}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="stockNum != null "> and stock_num = #{stockNum}</if>
            <if test="warnStock != null "> and warn_stock = #{warnStock}</if>
            <if test="purchasePrice != null "> and purchase_price = #{purchasePrice}</if>
            <if test="salePrice != null "> and sale_price = #{salePrice}</if>
            <if test="thumbUrl != null  and thumbUrl != ''"> and thumb_url = #{thumbUrl}</if>
            <if test="originUrl != null  and originUrl != ''"> and origin_url = #{originUrl}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectWmsGoodsByGoodsId" parameterType="Long" resultMap="WmsGoodsResult">
        <include refid="selectWmsGoodsVo"/>
        where goods_id = #{goodsId}
    </select>

    <insert id="insertWmsGoods" parameterType="WmsGoods" useGeneratedKeys="true" keyProperty="goodsId">
        insert into wms_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="goodsNo != null">goods_no,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="spec != null">spec,</if>
            <if test="unit != null">unit,</if>
            <if test="stockNum != null">stock_num,</if>
            <if test="warnStock != null">warn_stock,</if>
            <if test="purchasePrice != null">purchase_price,</if>
            <if test="salePrice != null">sale_price,</if>
            <if test="thumbUrl != null">thumb_url,</if>
            <if test="originUrl != null">origin_url,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="goodsNo != null">#{goodsNo},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="spec != null">#{spec},</if>
            <if test="unit != null">#{unit},</if>
            <if test="stockNum != null">#{stockNum},</if>
            <if test="warnStock != null">#{warnStock},</if>
            <if test="purchasePrice != null">#{purchasePrice},</if>
            <if test="salePrice != null">#{salePrice},</if>
            <if test="thumbUrl != null">#{thumbUrl},</if>
            <if test="originUrl != null">#{originUrl},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateWmsGoods" parameterType="WmsGoods">
        update wms_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="goodsNo != null">goods_no = #{goodsNo},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="stockNum != null">stock_num = #{stockNum},</if>
            <if test="warnStock != null">warn_stock = #{warnStock},</if>
            <if test="purchasePrice != null">purchase_price = #{purchasePrice},</if>
            <if test="salePrice != null">sale_price = #{salePrice},</if>
            <if test="thumbUrl != null">thumb_url = #{thumbUrl},</if>
            <if test="originUrl != null">origin_url = #{originUrl},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where goods_id = #{goodsId}
    </update>

    <delete id="deleteWmsGoodsByGoodsId" parameterType="Long">
        delete from wms_goods where goods_id = #{goodsId}
    </delete>

    <delete id="deleteWmsGoodsByGoodsIds" parameterType="String">
        delete from wms_goods where goods_id in 
        <foreach item="goodsId" collection="array" open="(" separator="," close=")">
            #{goodsId}
        </foreach>
    </delete>
</mapper>